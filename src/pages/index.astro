---
import '../styles/global.css';

const products = [
  {
    name: 'Wake',
    eyebrow: 'The electric dayboat, tuned for open water',
    image: 'https://images.pexels.com/photos/1555318/pexels-photo-1555318.jpeg?auto=compress&cs=tinysrgb&w=2400',
    actions: ['Configure', 'Explore'],
  },
  {
    name: 'Range',
    eyebrow: 'A coastal cruiser designed without compromise',
    image: 'https://images.pexels.com/photos/5114902/pexels-photo-5114902.jpeg?auto=compress&cs=tinysrgb&w=2400',
    actions: ['Reserve', 'Explore'],
  },
  {
    name: 'Utility',
    eyebrow: 'Clean power for crews that never slow down',
    image: 'https://images.pexels.com/photos/4701633/pexels-photo-4701633.jpeg?auto=compress&cs=tinysrgb&w=2400',
    actions: ['Explore'],
  },
];

const features = [
  {
    title: 'Intelligent control',
    copy: 'One responsive system manages propulsion, navigation, safety, and energy in real time.',
    image: 'https://images.pexels.com/photos/6965424/pexels-photo-6965424.jpeg?auto=compress&cs=tinysrgb&w=1400',
  },
  {
    title: 'Immediate power',
    copy: 'Silent torque arrives the moment you ask for it, with precision from dock to open water.',
    image: 'https://images.pexels.com/photos/9413460/pexels-photo-9413460.jpeg?auto=compress&cs=tinysrgb&w=1400',
  },
  {
    title: 'Minimal upkeep',
    copy: 'Fewer moving parts mean fewer service days, lower costs, and more time underway.',
    image: 'https://images.pexels.com/photos/5979928/pexels-photo-5979928.jpeg?auto=compress&cs=tinysrgb&w=1400',
  },
  {
    title: 'Built nearby',
    copy: 'Engineered and assembled by one team, with every critical system under one roof.',
    image: 'https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1400&q=85',
  },
];

const stories = [
  ['A cleaner fleet begins on the harbor', 'How electric propulsion is changing daily operations.', 'Read'],
  ['Three thousand miles of testing', 'What we learned from a season beyond the breakwater.', 'Read'],
  ['Build the next era with us', 'Design hard things with a small, exacting team.', 'View'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Nova creates intelligent electric boats for life and work on the water." />
    <title>Nova — Electric Marine</title>
  </head>
  <body>
    <header class="site-header" data-header>
      <button class="menu-trigger" type="button" aria-label="Open menu" aria-expanded="false" data-menu-trigger>
        <span></span><span></span>
      </button>
      <a class="wordmark" href="#top" aria-label="Nova home">nova</a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#recreation">Recreation <span aria-hidden="true">⌄</span></a>
        <a href="#utility">Commercial</a>
        <a href="#technology">Technology</a>
      </nav>
      <a class="header-cta" href="#newsletter">Stay informed</a>
    </header>

    <aside class="menu-panel" aria-hidden="true" data-menu-panel>
      <div class="menu-inner">
        <p class="meta">Explore Nova</p>
        <nav aria-label="Menu navigation">
          <a href="#recreation">Recreation</a>
          <a href="#utility">Commercial</a>
          <a href="#technology">Technology</a>
          <a href="#journal">Journal</a>
        </nav>
        <div class="menu-foot">
          <a href="#newsletter">Newsletter</a>
          <a href="mailto:hello@nova-marine.example">Contact</a>
        </div>
      </div>
    </aside>

    <main id="top">
      <section class="hero section-dark">
        <img class="hero-media" src="https://images.pexels.com/photos/8613167/pexels-photo-8613167.jpeg?auto=compress&cs=tinysrgb&w=2400" alt="A boat cutting across deep blue water" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="meta meta-light"><span class="origin-mark" aria-hidden="true"></span>Designed and built on the Pacific</p>
          <h1>Moving the marine<br />world forward</h1>
          <div class="button-row">
            <a class="button button-light" href="#recreation">Recreation</a>
            <a class="button button-light" href="#utility">Commercial</a>
          </div>
        </div>
        <a class="scroll-cue" href="#statement" aria-label="Continue to the next section"><span></span>Scroll</a>
      </section>

      <section class="statement" id="statement">
        <h2>Electric power made for<br />everything the water asks of you.</h2>
      </section>

      <div id="recreation">
        {products.map((product, index) => (
          <section class="product-scene" id={index === 2 ? 'utility' : undefined}>
            <img src={product.image} alt={`Nova ${product.name} electric boat on the water`} loading="lazy" />
            <div class="scene-shade"></div>
            <p class="product-name">{product.name}</p>
            <div class="product-content">
              <h2>{product.eyebrow}</h2>
              <div class="button-row button-row-center">
                {product.actions.map((action) => <a class="button button-light" href="#newsletter">{action}</a>)}
              </div>
            </div>
          </section>
        ))}
      </div>

      <section class="features section-dark" id="technology">
        <div class="section-shell">
          <div class="feature-head">
            <p class="meta meta-light">Electric by design</p>
            <h2>More power. Less upkeep.<br />A better day on the water.</h2>
            <div class="slider-controls" aria-label="Feature carousel controls">
              <button type="button" data-slider-prev aria-label="Previous feature">←</button>
              <button type="button" data-slider-next aria-label="Next feature">→</button>
            </div>
          </div>
          <div class="feature-viewport">
            <div class="feature-track" data-feature-track>
              {features.map((feature) => (
                <article class="feature-card">
                  <img src={feature.image} alt="" loading="lazy" />
                  <div class="feature-card-copy">
                    <h3>{feature.title}</h3>
                    <p>{feature.copy}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="possibility">
        <img src="https://images.unsplash.com/photo-1473496169904-658ba7c44d8a?auto=format&fit=crop&w=2400&q=88" alt="Open water beneath a clear sky" loading="lazy" />
        <div class="scene-shade"></div>
        <p>Endless possibility<br />on the water</p>
      </section>

      <section class="stories" id="journal">
        <div class="section-shell">
          <p class="meta">From Nova</p>
          <div class="story-grid">
            {stories.map((story, index) => (
              <article class="story-card">
                <div>
                  <p class="story-index">0{index + 1}</p>
                  <h3>{story[0]}</h3>
                  <p>{story[1]}</p>
                </div>
                <a href="#newsletter">{story[2]} <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
          <figure class="factory-image">
            <img src="https://images.pexels.com/photos/12114679/pexels-photo-12114679.jpeg?auto=compress&cs=tinysrgb&w=2400" alt="A fabricator welding in a modern workshop" loading="lazy" />
          </figure>
        </div>
      </section>
    </main>

    <footer id="newsletter">
      <div class="footer-statement">Make room for<br />what comes next.</div>
      <div class="newsletter-block">
        <p class="meta meta-light">Newsletter</p>
        <h2>Product notes, test rides, and stories from the water.</h2>
        <form data-newsletter novalidate>
          <label class="sr-only" for="email">Email address</label>
          <input id="email" type="email" name="email" placeholder="Enter email" required />
          <button type="submit">Subscribe</button>
        </form>
        <p class="form-status" role="status" data-form-status></p>
      </div>
      <div class="footer-links">
        <div><p class="meta meta-light">Experience</p><a href="#recreation">Wake</a><a href="#recreation">Range</a><a href="#utility">Utility</a></div>
        <div><p class="meta meta-light">Company</p><a href="#journal">Journal</a><a href="#technology">Technology</a><a href="mailto:hello@nova-marine.example">Contact</a></div>
        <div><p class="meta meta-light">Social</p><a href="#">Instagram</a><a href="#">YouTube</a><a href="#">LinkedIn</a></div>
      </div>
      <div class="footer-bottom"><a class="footer-wordmark" href="#top">nova</a><p>© 2026 Nova Marine. Concept website.</p></div>
    </footer>

    <script>
      const trigger = document.querySelector('[data-menu-trigger]');
      const panel = document.querySelector('[data-menu-panel]');
      const header = document.querySelector('[data-header]');

      const setMenu = (open: boolean) => {
        document.body.classList.toggle('menu-open', open);
        trigger?.setAttribute('aria-expanded', String(open));
        trigger?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        panel?.setAttribute('aria-hidden', String(!open));
      };

      trigger?.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
      panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => event.key === 'Escape' && setMenu(false));

      const updateHeader = () => header?.classList.toggle('header-scrolled', window.scrollY > window.innerHeight * 0.72);
      updateHeader();
      addEventListener('scroll', updateHeader, { passive: true });

      const track = document.querySelector<HTMLElement>('[data-feature-track]');
      let slideIndex = 0;
      const featureCount = track?.children.length ?? 0;
      const updateSlider = () => {
        if (!track) return;
        const step = window.innerWidth < 760 ? 88 : 34;
        track.style.transform = `translateX(-${slideIndex * step}vw)`;
      };
      document.querySelector('[data-slider-next]')?.addEventListener('click', () => {
        slideIndex = Math.min(slideIndex + 1, Math.max(0, featureCount - (window.innerWidth < 760 ? 1 : 3)));
        updateSlider();
      });
      document.querySelector('[data-slider-prev]')?.addEventListener('click', () => {
        slideIndex = Math.max(0, slideIndex - 1);
        updateSlider();
      });
      addEventListener('resize', updateSlider);

      const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
      const status = document.querySelector('[data-form-status]');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = form.querySelector('input');
        if (!(input instanceof HTMLInputElement) || !input.validity.valid) {
          if (status) status.textContent = 'Enter a valid email address.';
          input?.focus();
          return;
        }
        if (status) status.textContent = 'You’re on the list. Welcome aboard.';
        form.reset();
      });
    </script>
  </body>
</html>
